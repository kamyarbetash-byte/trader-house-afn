{
  "name": "rahbar-pay",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./styles/app.css -o ./public/assets/app.css --minify",
    "watch:css": "tailwindcss -i ./styles/app.css -o ./public/assets/app.css --watch",
    "dev": "npm run build:css && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply rahbar-pay --local",
    "db:migrate:remote": "wrangler d1 migrations apply rahbar-pay --remote",
    "deploy": "npm run build:css && wrangler deploy"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.158.0"
  }
}
